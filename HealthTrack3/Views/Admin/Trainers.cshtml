@model List<HealthTrack3.Models.AdminTrainerRow>
@{
    ViewBag.Title = "Manage Trainers";
}

<h2 class="page-title"><i class="fa-solid fa-person-running"></i> Manage Trainers</h2>
<p class="text-muted">Workload of each trainer. Assign clients from the Users page.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]</div>
}

<div class="panel-ht">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-user-slash"></i>
            <p>No trainers have registered yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-ht">
                <thead>
                    <tr><th>Trainer</th><th>Clients</th><th>Pending appointments</th><th>Total appointments</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.FullName<div class="small text-muted">@t.Email</div></td>
                            <td>@t.ClientCount</td>
                            <td>@t.PendingAppointments</td>
                            <td>@t.TotalAppointments</td>
                            <td>
                                <span class="status-badge @(t.IsLocked ? "status-cancelled" : "status-approved")">@(t.IsLocked ? "Disabled" : "Active")</span>
                            </td>
                            <td>
                                @using (Html.BeginForm("ToggleLock", "Admin", FormMethod.Post, new { @class = "inline-form", onsubmit = "return confirm('" + (t.IsLocked ? "Enable" : "Disable") + " this trainer?');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="returnTo" value="Trainers" />
                                    if (t.IsLocked)
                                    {
                                        <button type="submit" class="btn btn-ht btn-sm">Enable</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-danger-ht btn-sm">Disable</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>