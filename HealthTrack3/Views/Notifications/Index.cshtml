@model List<HealthTrack3.Models.Notification>
@{
    ViewBag.Title = "Notifications";
    int unread = Model.Count(n => !n.IsRead);

    Func<string, string> iconOf = type =>
    {
        switch (type)
        {
            case "WorkoutReminder": return "fa-dumbbell";
            case "MealReminder": return "fa-utensils";
            case "Appointment":
            case "AppointmentReminder":
            case "PendingReminder": return "fa-calendar-check";
            case "Feedback": return "fa-comment-dots";
            case "Plan": return "fa-clipboard-list";
            case "Assignment": return "fa-user-check";
            default: return "fa-bell";
        }
    };

    Func<DateTime, string> ago = d =>
    {
        var span = DateTime.Now - d;
        if (span.TotalMinutes < 1) { return "Just now"; }
        if (span.TotalMinutes < 60) { return (int)span.TotalMinutes + " min ago"; }
        if (span.TotalHours < 24) { return (int)span.TotalHours + " h ago"; }
        return d.ToString("dd MMM yyyy, hh:mm tt");
    };
}

<h2 class="page-title"><i class="fa-solid fa-bell"></i> Notifications</h2>
<p class="text-muted">Reminders and updates about your workouts, meals and appointments.</p>

<div class="panel-ht">
    <div class="notif-header">
        <h4 style="border:none; margin:0; padding:0;">
            @(unread > 0 ? unread + " unread" : "You are all caught up")
        </h4>
        @if (unread > 0)
        {
            using (Html.BeginForm("MarkAllRead", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-default btn-sm"><i class="fa-solid fa-check-double"></i> Mark all as read</button>
            }
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-bell-slash"></i>
            <p>No notifications yet.</p>
        </div>
    }
    else
    {
        foreach (var n in Model)
        {
            <div class="notif-item @(n.IsRead ? "" : "unread")">
                <div class="notif-icon"><i class="fa-solid @iconOf(n.Type)"></i></div>
                <div class="notif-body">
                    <div class="notif-msg">@n.Message</div>
                    <div class="notif-time">@ago(n.CreatedAt)</div>
                </div>
                <div class="notif-actions">
                    @if (!n.IsRead)
                    {
                        using (Html.BeginForm("MarkRead", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-default btn-sm" title="Mark as read"><i class="fa-solid fa-check"></i></button>
                        }
                    }
                    @using (Html.BeginForm("Delete", "Notifications", FormMethod.Post, new { @class = "inline-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@n.Id" />
                        <button type="submit" class="btn btn-default btn-sm" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    }
                </div>
            </div>
        }
    }
</div>