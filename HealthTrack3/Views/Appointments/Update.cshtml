@model HealthTrack3.Models.Appointment
@{
    ViewBag.Title = "Update Appointment";
    string clientName = string.IsNullOrEmpty(Model.Client.FullName) ? Model.Client.Email : Model.Client.FullName;
}

<h2 class="page-title"><i class="fa-solid fa-calendar-pen"></i> Update appointment</h2>
<p class="text-muted">Client: <strong>@clientName</strong> | Reason: @Model.Reason</p>

<div class="row">
    <div class="col-md-6">
        <div class="panel-ht">
            @using (Html.BeginForm("Update", "Appointments", new { id = Model.Id }, FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="form-group">
                    <label for="appointmentDate">New date and time</label>
                    <input type="datetime-local" id="appointmentDate" name="appointmentDate" class="form-control"
                           value="@Model.AppointmentDate.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
                <div class="form-group">
                    <label for="trainerNote">Note for the client (optional)</label>
                    <textarea id="trainerNote" name="trainerNote" class="form-control" rows="3" maxlength="300"
                              style="height:auto;" placeholder="e.g. Please bring your workout log">@Model.TrainerNote</textarea>
                </div>
                <button type="submit" class="btn btn-ht"><i class="fa-solid fa-floppy-disk"></i> Save changes</button>
                <a href="@Url.Action("Manage", "Appointments")" class="btn btn-default">Back</a>
            }
        </div>
    </div>
</div>