@model List<HealthTrack3.Models.Appointment>
@{
    ViewBag.Title = "Appointments";
    Func<HealthTrack3.Models.ApplicationUser, string> nameOf = u => string.IsNullOrEmpty(u.FullName) ? u.Email : u.FullName;
}

<h2 class="page-title"><i class="fa-solid fa-calendar-check"></i> Appointment Requests</h2>
<p class="text-muted">Approve, reschedule or cancel appointments booked by your clients.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> @TempData["Error"]</div>
}

<div class="panel-ht">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="fa-solid fa-calendar-xmark"></i>
            <p>No appointment requests yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-ht">
                <thead>
                    <tr><th>When</th><th>Client</th><th>Reason</th><th>Status</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.AppointmentDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td>@nameOf(a.Client)</td>
                            <td>
                                @a.Reason
                                @if (!string.IsNullOrEmpty(a.TrainerNote))
                                {
                                    <div class="small text-muted"><i class="fa-solid fa-comment-dots"></i> @a.TrainerNote</div>
                                }
                            </td>
                            <td><span class="status-badge status-@a.Status.ToString().ToLower()">@a.Status</span></td>
                            <td>
                                @if (a.Status == HealthTrack3.Models.AppointmentStatus.Pending)
                                {
                                    using (Html.BeginForm("Approve", "Appointments", FormMethod.Post, new { @class = "inline-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="btn btn-ht btn-sm">Approve</button>
                                    }
                                }
                                @if (a.Status != HealthTrack3.Models.AppointmentStatus.Cancelled)
                                {
                                    <a href="@Url.Action("Update", "Appointments", new { id = a.Id })" class="btn btn-default btn-sm">Update</a>
                                    using (Html.BeginForm("TrainerCancel", "Appointments", FormMethod.Post, new { @class = "inline-form", onsubmit = "return confirm('Cancel this appointment?');" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="btn btn-danger-ht btn-sm">Cancel</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>