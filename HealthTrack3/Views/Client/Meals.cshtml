@model HealthTrack3.Models.MealLog
@{
    ViewBag.Title = "Meal Log";
    var history = (List<HealthTrack3.Models.MealLog>)ViewBag.History;
}

<h2 class="page-title"><i class="fa-solid fa-utensils"></i> Meal Log</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="panel-ht">
            <h4>Log a meal</h4>
            @using (Html.BeginForm("Meals", "Client", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.LoggedOn)
                    @Html.TextBoxFor(m => m.LoggedOn, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.LoggedOn, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.MealType)
                    @Html.DropDownListFor(m => m.MealType, (SelectList)ViewBag.MealTypes, "-- Select --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.MealType, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.FoodName)
                    @Html.TextBoxFor(m => m.FoodName, new { @class = "form-control", placeholder = "e.g. Rice and chicken" })
                    @Html.ValidationMessageFor(m => m.FoodName, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Calories)
                    @Html.TextBoxFor(m => m.Calories, new { @class = "form-control", type = "number" })
                    @Html.ValidationMessageFor(m => m.Calories, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="btn btn-ht">Save</button>
            }
        </div>
    </div>
    <div class="col-md-8">
        <div class="panel-ht">
            <h4>Recent meals</h4>
            @if (history.Count == 0)
            {
                <p class="text-muted">No meals logged yet.</p>
            }
            else
            {
                <table class="table table-ht">
                    <thead>
                        <tr><th>Date</th><th>Meal</th><th>Food</th><th>Calories</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in history)
                        {
                            <tr>
                                <td>@m.LoggedOn.ToString("dd MMM yyyy")</td>
                                <td>@m.MealType</td>
                                <td>@m.FoodName</td>
                                <td>@m.Calories</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}