@model HealthTrack3.Models.WorkoutLog
@{
    ViewBag.Title = "Workout Log";
    var history = (List<HealthTrack3.Models.WorkoutLog>)ViewBag.History;
}

<h2 class="page-title"><i class="fa-solid fa-dumbbell"></i> Workout Log</h2>
<p class="text-muted">Record every session to track your calories burned.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> @TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="panel-ht">
            <h4>Log a workout</h4>
            @using (Html.BeginForm("Workouts", "Client", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.LoggedOn)
                    @Html.TextBoxFor(m => m.LoggedOn, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.LoggedOn, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.ExerciseName)
                    <div class="input-icon">
                        <i class="fa-solid fa-person-running"></i>
                        @Html.TextBoxFor(m => m.ExerciseName, new { @class = "form-control", placeholder = "e.g. Running" })
                    </div>
                    @Html.ValidationMessageFor(m => m.ExerciseName, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.DurationMinutes)
                    <div class="input-icon">
                        <i class="fa-solid fa-stopwatch"></i>
                        @Html.TextBoxFor(m => m.DurationMinutes, new { @class = "form-control", type = "number", min = "1", max = "600", placeholder = "e.g. 30" })
                    </div>
                    @Html.ValidationMessageFor(m => m.DurationMinutes, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.CaloriesBurned)
                    <div class="input-icon">
                        <i class="fa-solid fa-fire"></i>
                        @Html.TextBoxFor(m => m.CaloriesBurned, new { @class = "form-control", type = "number", min = "0", max = "5000", placeholder = "e.g. 250" })
                    </div>
                    @Html.ValidationMessageFor(m => m.CaloriesBurned, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="btn btn-ht btn-block"><i class="fa-solid fa-floppy-disk"></i> Save workout</button>
            }
        </div>
    </div>
    <div class="col-md-8">
        <div class="panel-ht">
            <h4>Recent workouts</h4>
            @if (history.Count == 0)
            {
                <div class="empty-state">
                    <i class="fa-solid fa-dumbbell"></i>
                    <p>No workouts logged yet. Add your first one!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-ht">
                        <thead>
                            <tr><th>Date</th><th>Exercise</th><th>Minutes</th><th>Calories burned</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var w in history)
                            {
                                <tr>
                                    <td>@w.LoggedOn.ToString("dd MMM yyyy")</td>
                                    <td>@w.ExerciseName</td>
                                    <td>@w.DurationMinutes</td>
                                    <td>@w.CaloriesBurned</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}