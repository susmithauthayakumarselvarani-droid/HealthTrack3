@model HealthTrack3.Models.HealthMetric
@{
    ViewBag.Title = "Health Measurements";
    var history = (List<HealthTrack3.Models.HealthMetric>)ViewBag.History;
}

<h2 class="page-title"><i class="fa-solid fa-weight-scale"></i> Health Measurements</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="panel-ht">
            <h4>Add measurement</h4>
            @using (Html.BeginForm("Metrics", "Client", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.RecordedOn)
                    @Html.TextBoxFor(m => m.RecordedOn, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.RecordedOn, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.WeightKg)
                    @Html.TextBoxFor(m => m.WeightKg, new { @class = "form-control", type = "number", step = "0.1" })
                    @Html.ValidationMessageFor(m => m.WeightKg, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.HeightCm)
                    @Html.TextBoxFor(m => m.HeightCm, new { @class = "form-control", type = "number", step = "0.1" })
                    @Html.ValidationMessageFor(m => m.HeightCm, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.CaloriesBurned)
                    @Html.TextBoxFor(m => m.CaloriesBurned, new { @class = "form-control", type = "number" })
                    @Html.ValidationMessageFor(m => m.CaloriesBurned, "", new { @class = "text-danger" })
                </div>
                <button type="submit" class="btn btn-ht">Save</button>
            }
        </div>
    </div>
    <div class="col-md-8">
        <div class="panel-ht">
            <h4>Recent measurements</h4>
            @if (history.Count == 0)
            {
                <p class="text-muted">Nothing recorded yet.</p>
            }
            else
            {
                <table class="table table-ht">
                    <thead>
                        <tr><th>Date</th><th>Weight (kg)</th><th>Height (cm)</th><th>BMI</th><th>Calories burned</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in history)
                        {
                            <tr>
                                <td>@m.RecordedOn.ToString("dd MMM yyyy")</td>
                                <td>@m.WeightKg.ToString("0.#")</td>
                                <td>@m.HeightCm.ToString("0.#")</td>
                                <td>@m.Bmi.ToString("0.0")</td>
                                <td>@m.CaloriesBurned</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}